# GroundMap internal single-user test configuration.
# Copy to .env.local and keep that file private.

# Leave blank to use test-kit/demo-data.
KB_ROOT=
KB_WORKSPACE=groundmap-demo
KB_API_BASE=http://127.0.0.1:3006
NEXT_PUBLIC_KB_URL=http://127.0.0.1:3006
NEXT_PUBLIC_CONSOLE_URL=http://127.0.0.1:3100

# Optional providers. Never commit or share real keys.
DEEPSEEK_API_KEY=
WEB_SEARCH_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local audio transcription. The first-run launcher prepares this model.
KB_WHISPER_MODEL=small
KB_WHISPER_DEVICE=cpu
KB_WHISPER_COMPUTE_TYPE=int8
KB_WHISPER_LANGUAGE=zh
KB_WHISPER_CHUNK_SEC=600

CLAUDE_CODE_BIN=claude
CODEX_BIN=codex
