# 主管理台 API 入口（web/ 启动的端口，默认 3006）
KB_API_BASE=http://localhost:3006
# 浏览器端“知识库”按钮目标；默认与 KB_API_BASE 相同。
NEXT_PUBLIC_KB_URL=http://localhost:3006

# 各模型 provider 的 API key（按需配置；未填则该 provider 在 UI 中灰显）。
# key 只在此文件提供，界面没有输入框；本文件已被 .gitignore 忽略、不进仓库——勿提交真实 key。
# DeepSeek key 申请：https://platform.deepseek.com（注意 deepseek-v4 默认已关思考模式，见 README）
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hybrid 问答使用 DeepSeek Responses API 的原生 Web Search，并复用 DEEPSEEK_API_KEY。
WEB_SEARCH_MODEL=deepseek-v4-flash

# OpenAI 兼容端点的自定义 baseURL（如 Moonshot / Qwen / 自建网关）。空 = 用 OpenAI 官方
OPENAI_BASE_URL=

# Claude Code / Codex CLI 二进制名（PATH 中可执行即可）
CLAUDE_CODE_BIN=claude
CODEX_BIN=codex
# 可选：工作台每次模型运行的 JSONL 账本；不设置时写入 tools/debug-console/.cache/run-metrics.jsonl
# KB_METRICS_FILE=E:/kb-data/workspaces/main/projects/acceptance/run-metrics.jsonl
# 可选：本轮批量验收标识；相同 batch id 的模型调用可自动汇总
# KB_BATCH_ID=sio-ingest-001
